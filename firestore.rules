rules_version = '2';

// Fuelの Firestore セキュリティルール。
//
// 守る境界はひとつ「本人以外は、その人のデータに一切触れない」。
// あわせて、アプリと同じ値の範囲（docs/requirements.md 6章、
// lib/models/*.dart、functions/src/nutrition_logic.ts）をここでも検証する。
// ルールはアプリを経由しない直接アクセスに対する最後の砦であり、アプリの
// 不具合で壊れた値が保存されて画面が落ちるのを防ぐ役目もある。
// 値の範囲を変えるときは3か所とも揃え、rules_test/ にテストを足すこと。
//
// リポジトリにあるだけでは本番へ反映されない。release-stg.yml の
// 「Deploy Firestore rules」ステップがデプロイする。
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNumberIn(v, lo, hi) {
      return (v is int || v is float) && v >= lo && v <= hi;
    }

    function isStringWithin(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }

    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 食べ物1品（記録・お気に入り共通）
    function isValidFood(d) {
      return isStringWithin(d.name, 1, 60)
        && isStringWithin(d.amount, 0, 40)
        && isNumberIn(d.calories, 0, 5000)
        && isNumberIn(d.protein, 0, 500)
        && isNumberIn(d.fat, 0, 500)
        && isNumberIn(d.carbs, 0, 500);
    }

    function isValidRatio(r) {
      return r is int && r >= 5 && r <= 70;
    }

    // 目標に合うペースか（維持は0、減量は0.25/0.5/0.75、増量は0.25/0.5 kg/週）
    function isValidGoalRate(goal, rate) {
      return (goal == 'lose' && rate in [0.25, 0.5, 0.75])
        || (goal == 'maintain' && rate == 0)
        || (goal == 'gain' && rate in [0.25, 0.5]);
    }

    function isValidProfile(p) {
      return p is map
        && p.keys().hasOnly([
          'sex', 'age', 'heightCm', 'weightKg', 'activityLevel', 'goal',
          'weeklyRateKg', 'pfcPreset', 'proteinRatio', 'fatRatio', 'carbsRatio',
          'targetWeightKg', 'customTargetKcal'
        ])
        && p.keys().hasAll([
          'sex', 'age', 'heightCm', 'weightKg', 'activityLevel', 'goal',
          'weeklyRateKg', 'pfcPreset', 'proteinRatio', 'fatRatio', 'carbsRatio'
        ])
        && p.sex in ['male', 'female']
        && p.age is int && p.age >= 15 && p.age <= 100
        && isNumberIn(p.heightCm, 120, 220)
        && isNumberIn(p.weightKg, 30, 250)
        && p.activityLevel in ['sedentary', 'light', 'moderate', 'active', 'veryActive']
        && isValidGoalRate(p.goal, p.weeklyRateKg)
        && p.pfcPreset in ['balanced', 'highProtein', 'lowFat', 'lowCarb', 'custom']
        && isValidRatio(p.proteinRatio)
        && isValidRatio(p.fatRatio)
        && isValidRatio(p.carbsRatio)
        && p.proteinRatio + p.fatRatio + p.carbsRatio == 100
        // 任意項目はnullを明示的に保存する（Dart側の toMap と同じ形）
        && (p.get('targetWeightKg', null) == null
            || isNumberIn(p.targetWeightKg, 30, 250))
        && (p.get('customTargetKcal', null) == null
            || (p.customTargetKcal is int
                && p.customTargetKcal >= 1000 && p.customTargetKcal <= 5000));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // profileは丸ごと検証する。体重の記録で profile.weightKg だけを
      // 更新する場合も、更新後のprofile全体が有効でなければ拒否される。
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['profile', 'updatedAt'])
        && (!('profile' in request.resource.data)
            || isValidProfile(request.resource.data.profile))
        && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp);
      // 退会はCloud Functions（deleteAccount、Admin SDK）がサブコレクションごと
      // まとめて削除する。クライアントから本体だけ消すとサブコレクションが
      // 取り残されるので、ここでは許可しない。
      allow delete: if false;

      // 食事の記録（1品＝1ドキュメント）
      match /meals/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'date', 'mealType', 'name', 'amount', 'calories', 'protein',
            'fat', 'carbs', 'source', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'date', 'mealType', 'name', 'amount', 'calories', 'protein',
            'fat', 'carbs', 'source', 'createdAt'
          ])
          && isDateKey(request.resource.data.date)
          && request.resource.data.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
          && isValidFood(request.resource.data)
          && request.resource.data.source in ['ai', 'manual', 'favorite', 'recent']
          && request.resource.data.createdAt is timestamp;
      }

      // 体重（1日1件。ドキュメントID＝日付）
      match /weights/{dateKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isDateKey(dateKey)
          && request.resource.data.keys().hasOnly(['date', 'weightKg', 'updatedAt'])
          && request.resource.data.date == dateKey
          && isNumberIn(request.resource.data.weightKg, 30, 250)
          && request.resource.data.updatedAt is timestamp;
      }

      // お気に入り
      match /favorites/{favoriteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'amount', 'calories', 'protein', 'fat', 'carbs', 'createdAt'
          ])
          && isValidFood(request.resource.data)
          && request.resource.data.createdAt is timestamp;
      }
    }

    // AI推定の回数制限。estimateNutrition（Cloud Functions、Admin SDK）だけが書く。
    // クライアントに書き込みを許すと、自分でカウントを0へ戻して
    // 1日の上限を外せてしまう。本人は残り回数の表示のために読むだけ。
    match /aiUsage/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
